{"page":523,"juz":27,"surah":"الطُّور","surahs":["الذَّاريَات","الطُّور"],"ayat":[{"s":51,"a":52,"n":"الذَّاريَات","l":[1,2],"t":"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبۡلِهِم مِّن رَّسُولٍ إِلَّا قَالُواْ سَاحِرٌ أَوۡ مَجۡنُونٌ ٥٢"},{"s":51,"a":53,"n":"الذَّاريَات","l":[2,2],"t":"أَتَوَاصَوۡاْ بِهِۦۚ بَلۡ هُمۡ قَوۡمٞ طَاغُونَ ٥٣"},{"s":51,"a":54,"n":"الذَّاريَات","l":[2,3],"t":"فَتَوَلَّ عَنۡهُمۡ فَمَآ أَنتَ بِمَلُومٖ ٥٤"},{"s":51,"a":55,"n":"الذَّاريَات","l":[3,3],"t":"وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِينَ ٥٥"},{"s":51,"a":56,"n":"الذَّاريَات","l":[3,4],"t":"وَمَا خَلَقۡتُ ٱلۡجِنَّ وَٱلۡإِنسَ إِلَّا لِيَعۡبُدُونِ ٥٦"},{"s":51,"a":57,"n":"الذَّاريَات","l":[4,5],"t":"مَآ أُرِيدُ مِنۡهُم مِّن رِّزۡقٖ وَمَآ أُرِيدُ أَن يُطۡعِمُونِ ٥٧"},{"s":51,"a":58,"n":"الذَّاريَات","l":[5,5],"t":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلۡقُوَّةِ ٱلۡمَتِينُ ٥٨"},{"s":51,"a":59,"n":"الذَّاريَات","l":[6,7],"t":"فَإِنَّ لِلَّذِينَ ظَلَمُواْ ذَنُوبٗا مِّثۡلَ ذَنُوبِ أَصۡحَٰبِهِمۡ فَلَا يَسۡتَعۡجِلُونِ ٥٩"},{"s":51,"a":60,"n":"الذَّاريَات","l":[7,7],"t":"فَوَيۡلٞ لِّلَّذِينَ كَفَرُواْ مِن يَوۡمِهِمُ ٱلَّذِي يُوعَدُونَ ٦٠"},{"s":52,"a":1,"n":"الطُّور","l":[10,10],"t":"وَٱلطُّورِ ١"},{"s":52,"a":2,"n":"الطُّور","l":[10,10],"t":"وَكِتَٰبٖ مَّسۡطُورٖ ٢"},{"s":52,"a":3,"n":"الطُّور","l":[10,10],"t":"فِي رَقّٖ مَّنشُورٖ ٣"},{"s":52,"a":4,"n":"الطُّور","l":[10,11],"t":"وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ ٤"},{"s":52,"a":5,"n":"الطُّور","l":[11,11],"t":"وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ ٥"},{"s":52,"a":6,"n":"الطُّور","l":[11,11],"t":"وَٱلۡبَحۡرِ ٱلۡمَسۡجُورِ ٦"},{"s":52,"a":7,"n":"الطُّور","l":[11,12],"t":"إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٞ ٧"},{"s":52,"a":8,"n":"الطُّور","l":[12,12],"t":"مَّا لَهُۥ مِن دَافِعٖ ٨"},{"s":52,"a":9,"n":"الطُّور","l":[12,13],"t":"يَوۡمَ تَمُورُ ٱلسَّمَآءُ مَوۡرٗا ٩"},{"s":52,"a":10,"n":"الطُّور","l":[13,13],"t":"وَتَسِيرُ ٱلۡجِبَالُ سَيۡرٗا ١٠"},{"s":52,"a":11,"n":"الطُّور","l":[13,13],"t":"فَوَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ١١"},{"s":52,"a":12,"n":"الطُّور","l":[14,14],
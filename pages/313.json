{"page":313,"juz":16,"surah":"طه","surahs":["طه"],"ayat":[{"s":20,"a":13,"n":"طه","l":[1,1],"t":"وَأَنَا ٱخۡتَرۡتُكَ فَٱسۡتَمِعۡ لِمَا يُوحَىٰٓ ١٣"},{"s":20,"a":14,"n":"طه","l":[1,2],"t":"إِنَّنِيٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعۡبُدۡنِي وَأَقِمِ ٱلصَّلَوٰةَ لِذِكۡرِيٓ ١٤"},{"s":20,"a":15,"n":"طه","l":[2,3],"t":"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخۡفِيهَا لِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا تَسۡعَىٰ ١٥"},{"s":20,"a":16,"n":"طه","l":[3,4],"t":"فَلَا يَصُدَّنَّكَ عَنۡهَا مَن لَّا يُؤۡمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرۡدَىٰ ١٦"},{"s":20,"a":17,"n":"طه","l":[4,5],"t":"وَمَا تِلۡكَ بِيَمِينِكَ يَٰمُوسَىٰ ١٧"},{"s":20,"a":18,"n":"طه","l":[5,6],"t":"قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيۡهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِي وَلِيَ فِيهَا مَـَٔارِبُ أُخۡرَىٰ ١٨"},{"s":20,"a":19,"n":"طه","l":[6,7],"t":"قَالَ أَلۡقِهَا يَٰمُوسَىٰ ١٩"},{"s":20,"a":20,"n":"طه","l":[7,7],"t":"فَأَلۡقَىٰهَا فَإِذَا هِيَ حَيَّةٞ تَسۡعَىٰ ٢٠"},{"s":20,"a":21,"n":"طه","l":[7,8],"t":"قَالَ خُذۡهَا وَلَا تَخَفۡۖ سَنُعِيدُهَا سِيرَتَهَا ٱلۡأُولَىٰ ٢١"},{"s":20,"a":22,"n":"طه","l":[8,9],"t":"وَٱضۡمُمۡ يَدَكَ إِلَىٰ جَنَاحِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٍ ءَايَةً أُخۡرَىٰ ٢٢"},{"s":20,"a":23,"n":"طه","l":[9,10],"t":"لِنُرِيَكَ مِنۡ ءَايَٰتِنَا ٱلۡكُبۡرَى ٢٣"},{"s":20,"a":24,"n":"طه","l":[10,10],"t":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ٢٤"},{"s":20,"a":25,"n":"طه","l":[10,11],"t":"قَالَ رَبِّ ٱشۡرَحۡ لِي صَدۡرِي ٢٥"},{"s":20,"a":26,"n":"طه","l":[11,11],"t":"وَيَسِّرۡ لِيٓ أَمۡرِي ٢٦"},{"s":20,"a":27,"n":"طه","l":[11,12],"t":"وَٱحۡلُلۡ عُقۡدَةٗ مِّن لِّسَانِي ٢٧"},{"s":20,"a":28,"n":"طه","l":[12,12],"t":"يَفۡقَهُواْ قَوۡلِي ٢٨"},{"s":20,"a":29,"n":"طه","l":[12,12],"t":"وَٱجۡعَل لِّي وَزِيرٗا مِّنۡ أَهۡلِي ٢٩"},{"s":20,"a":30,"n":"طه","l":[12,13],"t":"هَٰرُونَ أَخِي ٣٠"},{"s":20,"a":31,"n":"طه","l":[13,13],"t":"ٱشۡدُدۡ بِهِۦٓ أَزۡرِي ٣١"},{"s":20,"a":32,"n":"طه","l":[13,13],"t":"وَأَشۡرِكۡهُ فِيٓ أَمۡرِي ٣٢"},{"s":20,"a":33,"n":"طه","l":[13,14],"t":"كَيۡ نُسَبِّحَكَ كَثِيرٗا ٣٣"},{"s":20,"a":34,"n":"طه","l":[14,14],"t":"وَنَذۡكُرَكَ كَثِيرًا ٣٤"},{"s":20,"a":35,"n":"طه","l":[14,14],"t":"إِنَّكَ كُنتَ بِنَا بَصِيرٗا ٣٥"},{"s":20,"a":36,"n":"طه","l":[14,15],"t":"قَالَ قَدۡ أُوتِيتَ سُؤۡلَكَ يَٰمُوسَىٰ ٣٦"},{"s":20,"a":37,"n":"طه","l":[15,15],"t":"وَلَقَدۡ مَنَنَّا عَلَيۡكَ مَرَّةً أُخۡرَىٰٓ ٣٧"}]}
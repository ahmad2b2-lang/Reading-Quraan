{"page":526,"juz":27,"surah":"النَّجم","surahs":["النَّجم"],"ayat":[{"s":53,"a":1,"n":"النَّجم","l":[3,3],"t":"وَٱلنَّجۡمِ إِذَا هَوَىٰ ١"},{"s":53,"a":2,"n":"النَّجم","l":[3,3],"t":"مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ ٢"},{"s":53,"a":3,"n":"النَّجم","l":[3,4],"t":"وَمَا يَنطِقُ عَنِ ٱلۡهَوَىٰٓ ٣"},{"s":53,"a":4,"n":"النَّجم","l":[4,4],"t":"إِنۡ هُوَ إِلَّا وَحۡيٞ يُوحَىٰ ٤"},{"s":53,"a":5,"n":"النَّجم","l":[4,4],"t":"عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىٰ ٥"},{"s":53,"a":6,"n":"النَّجم","l":[4,5],"t":"ذُو مِرَّةٖ فَٱسۡتَوَىٰ ٦"},{"s":53,"a":7,"n":"النَّجم","l":[5,5],"t":"وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ ٧"},{"s":53,"a":8,"n":"النَّجم","l":[5,5],"t":"ثُمَّ دَنَا فَتَدَلَّىٰ ٨"},{"s":53,"a":9,"n":"النَّجم","l":[5,6],"t":"فَكَانَ قَابَ قَوۡسَيۡنِ أَوۡ أَدۡنَىٰ ٩"},{"s":53,"a":10,"n":"النَّجم","l":[6,6],"t":"فَأَوۡحَىٰٓ إِلَىٰ عَبۡدِهِۦ مَآ أَوۡحَىٰ ١٠"},{"s":53,"a":11,"n":"النَّجم","l":[6,7],"t":"مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰٓ ١١"},{"s":53,"a":12,"n":"النَّجم","l":[7,7],"t":"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ ١٢"},{"s":53,"a":13,"n":"النَّجم","l":[7,7],"t":"وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ ١٣"},{"s":53,"a":14,"n":"النَّجم","l":[8,8],"t":"عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ ١٤"},{"s":53,"a":15,"n":"النَّجم","l":[8,8],"t":"عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰٓ ١٥"},{"s":53,"a":16,"n":"النَّجم","l":[8,9],"t":"إِذۡ يَغۡشَى ٱلسِّدۡرَةَ مَا يَغۡشَىٰ ١٦"},{"s":53,"a":17,"n":"النَّجم","l":[9,9],"t":"مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ ١٧"},{"s":53,"a":18,"n":"النَّجم","l":[9,10],"t":"لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ ٱلۡكُبۡرَىٰٓ ١٨"},{"s":53,"a":19,"n":"النَّجم","l":[10,10],"t":"أَفَرَءَيۡتُمُ ٱللَّٰتَ وَٱلۡعُزَّىٰ ١٩"},{"s":53,"a":20,"n":"النَّجم","l":[10,10],"t":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ ٢٠"},{"s":53,"a":21,"n":"النَّجم","l":[11,11],"t":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ ٢١"},{"s":53,"a":22,"n":"النَّجم","l":[11,11],"t":"تِلۡكَ إِذٗا قِسۡمَةٞ ضِيزَىٰٓ ٢٢"},{"s":53,"a":23,"n":"النَّجم","l":[11,13],"t":"إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ ٢٣"},{"s":53,"a":24,"n":"النَّجم","l":[13,14],"t":"أَمۡ لِلۡإِنسَٰنِ مَا تَمَنَّىٰ ٢٤"},{"s":53,"a":25,"n":"النَّجم","l":[14,14],"t":"فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ ٢٥"},{"s":53,"a":26,"n":"النَّجم","l":[14,15],"t":"۞ وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَٰوَٰتِ لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ ٢٦"}]}
{"page":447,"juz":23,"surah":"الصَّافَات","surahs":["الصَّافَات"],"ayat":[{"s":37,"a":25,"n":"الصَّافَات","l":[1,1],"t":"مَا لَكُمۡ لَا تَنَاصَرُونَ ٢٥"},{"s":37,"a":26,"n":"الصَّافَات","l":[1,1],"t":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦"},{"s":37,"a":27,"n":"الصَّافَات","l":[1,2],"t":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧"},{"s":37,"a":28,"n":"الصَّافَات","l":[2,2],"t":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ٢٨"},{"s":37,"a":29,"n":"الصَّافَات","l":[3,3],"t":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩"},{"s":37,"a":30,"n":"الصَّافَات","l":[3,4],"t":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ ٣٠"},{"s":37,"a":31,"n":"الصَّافَات","l":[4,4],"t":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ٣١"},{"s":37,"a":32,"n":"الصَّافَات","l":[5,5],"t":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ٣٢"},{"s":37,"a":33,"n":"الصَّافَات","l":[5,6],"t":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ٣٣"},{"s":37,"a":34,"n":"الصَّافَات","l":[6,6],"t":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ٣٤"},{"s":37,"a":35,"n":"الصَّافَات","l":[6,7],"t":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ٣٥"},{"s":37,"a":36,"n":"الصَّافَات","l":[7,8],"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ ٣٦"},{"s":37,"a":37,"n":"الصَّافَات","l":[8,8],"t":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ٣٧"},{"s":37,"a":38,"n":"الصَّافَات","l":[8,9],"t":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ٣٨"},{"s":37,"a":39,"n":"الصَّافَات","l":[9,9],"t":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ٣٩"},{"s":37,"a":40,"n":"الصَّافَات","l":[10,10],"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٤٠"},{"s":37,"a":41,"n":"الصَّافَات","l":[10,10],"t":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ ٤١"},{"s":37,"a":42,"n":"الصَّافَات","l":[10,11],"t":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ٤٢"},{"s":37,"a":43,"n":"الصَّافَات","l":[11,11],"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ ٤٣"},{"s":37,"a":44,"n":"الصَّافَات","l":[11,11],"t":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ ٤٤"},{"s":37,"a":45,"n":"الصَّافَات","l":[12,12],"t":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ ٤٥"},{"s":37,"a":46,"n":"الصَّافَات","l":[12,12],"t":"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦"},{"s":37,"a":47,"n":"الصَّافَات","l":[13,13],"t":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ٤٧"},{"s":37,"a":48,"n":"الصَّافَات","l":[13,14],"t":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ ٤٨"},{"s":37,"a":49,"n":"الصَّافَات","l":[14,14],"t":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ ٤٩"},{"s":37,"a":50,"n":"الصَّافَات","l":[14,15],"t":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٥٠"},{"s":37,"a":51,"n":"الصَّافَات","l":[15,15],"t":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ ٥١"}]}
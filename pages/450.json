{"page":450,"juz":23,"surah":"الصَّافَات","surahs":["الصَّافَات"],"ayat":[{"s":37,"a":103,"n":"الصَّافَات","l":[1,1],"t":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ ١٠٣"},{"s":37,"a":104,"n":"الصَّافَات","l":[1,1],"t":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ ١٠٤"},{"s":37,"a":105,"n":"الصَّافَات","l":[2,2],"t":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٠٥"},{"s":37,"a":106,"n":"الصَّافَات","l":[2,3],"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ ١٠٦"},{"s":37,"a":107,"n":"الصَّافَات","l":[3,3],"t":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ ١٠٧"},{"s":37,"a":108,"n":"الصَّافَات","l":[3,4],"t":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ١٠٨"},{"s":37,"a":109,"n":"الصَّافَات","l":[4,4],"t":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ ١٠٩"},{"s":37,"a":110,"n":"الصَّافَات","l":[4,5],"t":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١١٠"},{"s":37,"a":111,"n":"الصَّافَات","l":[5,5],"t":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١١١"},{"s":37,"a":112,"n":"الصَّافَات","l":[5,6],"t":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ ١١٢"},{"s":37,"a":113,"n":"الصَّافَات","l":[6,7],"t":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ ١١٣"},{"s":37,"a":114,"n":"الصَّافَات","l":[7,8],"t":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١١٤"},{"s":37,"a":115,"n":"الصَّافَات","l":[8,9],"t":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ١١٥"},{"s":37,"a":116,"n":"الصَّافَات","l":[9,9],"t":"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ ١١٦"},{"s":37,"a":117,"n":"الصَّافَات","l":[9,10],"t":"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ ١١٧"},{"s":37,"a":118,"n":"الصَّافَات","l":[10,10],"t":"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ١١٨"},{"s":37,"a":119,"n":"الصَّافَات","l":[11,11],"t":"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ ١١٩"},{"s":37,"a":120,"n":"الصَّافَات","l":[11,12],"t":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ ١٢٠"},{"s":37,"a":121,"n":"الصَّافَات","l":[12,12],"t":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ١٢١"},{"s":37,"a":122,"n":"الصَّافَات","l":[12,13],"t":"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ١٢٢"},{"s":37,"a":123,"n":"الصَّافَات","l":[13,13],"t":"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ ١٢٣"},{"s":37,"a":124,"n":"الصَّافَات","l":[14,14],"t":"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ ١٢٤"},{"s":37,"a":125,"n":"الصَّافَات","l":[14,15],"t":"أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ ١٢٥"},{"s":37,"a":126,"n":"الصَّافَات","l":[15,15],"t":"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ ١٢٦"}]}
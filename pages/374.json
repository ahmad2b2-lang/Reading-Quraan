{"page":374,"juz":19,"surah":"الشعراء","surahs":["الشعراء"],"ayat":[{"s":26,"a":160,"n":"الشعراء","l":[1,1],"t":"كَذَّبَتۡ قَوۡمُ لُوطٍ ٱلۡمُرۡسَلِينَ ١٦٠"},{"s":26,"a":161,"n":"الشعراء","l":[1,2],"t":"إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ لُوطٌ أَلَا تَتَّقُونَ ١٦١"},{"s":26,"a":162,"n":"الشعراء","l":[2,2],"t":"إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ ١٦٢"},{"s":26,"a":163,"n":"الشعراء","l":[2,2],"t":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ ١٦٣"},{"s":26,"a":164,"n":"الشعراء","l":[2,3],"t":"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ ١٦٤"},{"s":26,"a":165,"n":"الشعراء","l":[4,4],"t":"أَتَأۡتُونَ ٱلذُّكۡرَانَ مِنَ ٱلۡعَٰلَمِينَ ١٦٥"},{"s":26,"a":166,"n":"الشعراء","l":[4,5],"t":"وَتَذَرُونَ مَا خَلَقَ لَكُمۡ رَبُّكُم مِّنۡ أَزۡوَٰجِكُمۚ بَلۡ أَنتُمۡ قَوۡمٌ عَادُونَ ١٦٦"},{"s":26,"a":167,"n":"الشعراء","l":[5,6],"t":"قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلۡمُخۡرَجِينَ ١٦٧"},{"s":26,"a":168,"n":"الشعراء","l":[6,6],"t":"قَالَ إِنِّي لِعَمَلِكُم مِّنَ ٱلۡقَالِينَ ١٦٨"},{"s":26,"a":169,"n":"الشعراء","l":[7,7],"t":"رَبِّ نَجِّنِي وَأَهۡلِي مِمَّا يَعۡمَلُونَ ١٦٩"},{"s":26,"a":170,"n":"الشعراء","l":[7,7],"t":"فَنَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ ١٧٠"},{"s":26,"a":171,"n":"الشعراء","l":[8,8],"t":"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ ١٧١"},{"s":26,"a":172,"n":"الشعراء","l":[8,8],"t":"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ ١٧٢"},{"s":26,"a":173,"n":"الشعراء","l":[8,9],"t":"وَأَمۡطَرۡنَا عَلَيۡهِم مَّطَرٗاۖ فَسَآءَ مَطَرُ ٱلۡمُنذَرِينَ ١٧٣"},{"s":26,"a":174,"n":"الشعراء","l":[9,10],"t":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ ١٧٤"},{"s":26,"a":175,"n":"الشعراء","l":[10,10],"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ١٧٥"},{"s":26,"a":176,"n":"الشعراء","l":[10,11],"t":"كَذَّبَ أَصۡحَٰبُ لۡـَٔيۡكَةِ ٱلۡمُرۡسَلِينَ ١٧٦"},{"s":26,"a":177,"n":"الشعراء","l":[11,11],"t":"إِذۡ قَالَ لَهُمۡ شُعَيۡبٌ أَلَا تَتَّقُونَ ١٧٧"},{"s":26,"a":178,"n":"الشعراء","l":[11,12],"t":"إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ ١٧٨"},{"s":26,"a":179,"n":"الشعراء","l":[12,12],"t":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ ١٧٩"},{"s":26,"a":180,"n":"الشعراء","l":[12,13],"t":"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ ١٨٠"},{"s":26,"a":181,"n":"الشعراء","l":[13,14],"t":"۞ أَوۡفُواْ ٱلۡكَيۡلَ وَلَا تَكُونُواْ مِنَ ٱلۡمُخۡسِرِينَ ١٨١"},{"s":26,"a":182,"n":"الشعراء","l":[14,14],"t":"وَزِنُواْ بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِ ١٨٢"},{"s":26,"a":183,"n":"الشعراء","l":[15,15],"t":"وَلَا تَبۡخَسُواْ ٱلنَّاسَ أَشۡيَآءَهُمۡ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ ١٨٣"}]}
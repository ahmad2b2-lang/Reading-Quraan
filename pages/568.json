{"page":568,"juz":29,"surah":"المَعَارج","surahs":["الحَاقة","المَعَارج"],"ayat":[{"s":69,"a":36,"n":"الحَاقة","l":[1,1],"t":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ ٣٦"},{"s":69,"a":37,"n":"الحَاقة","l":[1,1],"t":"لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ ٣٧"},{"s":69,"a":38,"n":"الحَاقة","l":[1,2],"t":"فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ ٣٨"},{"s":69,"a":39,"n":"الحَاقة","l":[2,2],"t":"وَمَا لَا تُبۡصِرُونَ ٣٩"},{"s":69,"a":40,"n":"الحَاقة","l":[2,2],"t":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ٤٠"},{"s":69,"a":41,"n":"الحَاقة","l":[2,3],"t":"وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ ٤١"},{"s":69,"a":42,"n":"الحَاقة","l":[3,3],"t":"وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ ٤٢"},{"s":69,"a":43,"n":"الحَاقة","l":[4,4],"t":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٤٣"},{"s":69,"a":44,"n":"الحَاقة","l":[4,4],"t":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ ٤٤"},{"s":69,"a":45,"n":"الحَاقة","l":[5,5],"t":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ ٤٥"},{"s":69,"a":46,"n":"الحَاقة","l":[5,5],"t":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ ٤٦"},{"s":69,"a":47,"n":"الحَاقة","l":[5,6],"t":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ ٤٧"},{"s":69,"a":48,"n":"الحَاقة","l":[6,6],"t":"وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ ٤٨"},{"s":69,"a":49,"n":"الحَاقة","l":[6,7],"t":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ٤٩"},{"s":69,"a":50,"n":"الحَاقة","l":[7,7],"t":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ ٥٠"},{"s":69,"a":51,"n":"الحَاقة","l":[8,8],"t":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ ٥١"},{"s":69,"a":52,"n":"الحَاقة","l":[8,8],"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٥٢"},{"s":70,"a":1,"n":"المَعَارج","l":[11,11],"t":"سَأَلَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١"},{"s":70,"a":2,"n":"المَعَارج","l":[11,11],"t":"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعٞ ٢"},{"s":70,"a":3,"n":"المَعَارج","l":[12,12],"t":"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ ٣"},{"s":70,"a":4,"n":"المَعَارج","l":[12,13],"t":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمٖ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةٖ ٤"},{"s":70,"a":5,"n":"المَعَارج","l":[13,13],"t":"فَٱصۡبِرۡ صَبۡرٗا جَمِيلًا ٥"},{"s":70,"a":6,"n":"المَعَارج","l":[14,14],"t":"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدٗا ٦"},{"s":70,"a":7,"n":"المَعَارج","l":[14,14],"t":"وَنَرَىٰهُ قَرِيبٗا ٧"},{"s":70,"a":8,"n":"المَعَارج","l":[14,15],"t":"يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ ٨"},{"s":70,"a":9,"n":"المَعَارج","l":[15,15],"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٩"},{"s":70,"a":10,"n":"المَعَارج","l":[15,15],"t":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمٗا ١٠"}]}
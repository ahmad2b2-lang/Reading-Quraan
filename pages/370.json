{"page":370,"juz":19,"surah":"الشعراء","surahs":["الشعراء"],"ayat":[{"s":26,"a":61,"n":"الشعراء","l":[1,1],"t":"فَلَمَّا تَرَٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ ٦١"},{"s":26,"a":62,"n":"الشعراء","l":[2,2],"t":"قَالَ كـَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ ٦٢"},{"s":26,"a":63,"n":"الشعراء","l":[2,3],"t":"فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقٖ كَٱلطَّوۡدِ ٱلۡعَظِيمِ ٦٣"},{"s":26,"a":64,"n":"الشعراء","l":[4,4],"t":"وَأَزۡلَفۡنَا ثَمَّ ٱلۡأٓخَرِينَ ٦٤"},{"s":26,"a":65,"n":"الشعراء","l":[4,4],"t":"وَأَنجَيۡنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجۡمَعِينَ ٦٥"},{"s":26,"a":66,"n":"الشعراء","l":[5,5],"t":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ ٦٦"},{"s":26,"a":67,"n":"الشعراء","l":[5,6],"t":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ ٦٧"},{"s":26,"a":68,"n":"الشعراء","l":[6,6],"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ٦٨"},{"s":26,"a":69,"n":"الشعراء","l":[7,7],"t":"وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ إِبۡرَٰهِيمَ ٦٩"},{"s":26,"a":70,"n":"الشعراء","l":[7,7],"t":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ ٧٠"},{"s":26,"a":71,"n":"الشعراء","l":[8,8],"t":"قَالُواْ نَعۡبُدُ أَصۡنَامٗا فَنَظَلُّ لَهَا عَٰكِفِينَ ٧١"},{"s":26,"a":72,"n":"الشعراء","l":[8,9],"t":"قَالَ هَلۡ يَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ ٧٢"},{"s":26,"a":73,"n":"الشعراء","l":[9,9],"t":"أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ ٧٣"},{"s":26,"a":74,"n":"الشعراء","l":[9,10],"t":"قَالُواْ بَلۡ وَجَدۡنَآ ءَابَآءَنَا كَذَٰلِكَ يَفۡعَلُونَ ٧٤"},{"s":26,"a":75,"n":"الشعراء","l":[10,11],"t":"قَالَ أَفَرَءَيۡتُم مَّا كُنتُمۡ تَعۡبُدُونَ ٧٥"},{"s":26,"a":76,"n":"الشعراء","l":[11,11],"t":"أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ ٧٦"},{"s":26,"a":77,"n":"الشعراء","l":[11,12],"t":"فَإِنَّهُمۡ عَدُوّٞ لِّيٓ إِلَّا رَبَّ ٱلۡعَٰلَمِينَ ٧٧"},{"s":26,"a":78,"n":"الشعراء","l":[12,12],"t":"ٱلَّذِي خَلَقَنِي فَهُوَ يَهۡدِينِ ٧٨"},{"s":26,"a":79,"n":"الشعراء","l":[12,13],"t":"وَٱلَّذِي هُوَ يُطۡعِمُنِي وَيَسۡقِينِ ٧٩"},{"s":26,"a":80,"n":"الشعراء","l":[13,13],"t":"وَإِذَا مَرِضۡتُ فَهُوَ يَشۡفِينِ ٨٠"},{"s":26,"a":81,"n":"الشعراء","l":[13,14],"t":"وَٱلَّذِي يُمِيتُنِي ثُمَّ يُحۡيِينِ ٨١"},{"s":26,"a":82,"n":"الشعراء","l":[14,15],"t":"وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي يَوۡمَ ٱلدِّينِ ٨٢"},{"s":26,"a":83,"n":"الشعراء","l":[15,15],"t":"رَبِّ هَبۡ لِي حُكۡمٗا وَأَلۡحِقۡنِي بِٱلصَّٰلِحِينَ ٨٣"}]}
{"page":375,"juz":19,"surah":"الشعراء","surahs":["الشعراء"],"ayat":[{"s":26,"a":184,"n":"الشعراء","l":[1,1],"t":"وَٱتَّقُواْ ٱلَّذِي خَلَقَكُمۡ وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ ١٨٤"},{"s":26,"a":185,"n":"الشعراء","l":[1,2],"t":"قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ ١٨٥"},{"s":26,"a":186,"n":"الشعراء","l":[2,3],"t":"وَمَآ أَنتَ إِلَّا بَشَرٞ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلۡكَٰذِبِينَ ١٨٦"},{"s":26,"a":187,"n":"الشعراء","l":[3,4],"t":"فَأَسۡقِطۡ عَلَيۡنَا كِسَفٗا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ١٨٧"},{"s":26,"a":188,"n":"الشعراء","l":[4,4],"t":"قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ ١٨٨"},{"s":26,"a":189,"n":"الشعراء","l":[4,5],"t":"فَكَذَّبُوهُ فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ ١٨٩"},{"s":26,"a":190,"n":"الشعراء","l":[6,6],"t":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ ١٩٠"},{"s":26,"a":191,"n":"الشعراء","l":[6,7],"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ١٩١"},{"s":26,"a":192,"n":"الشعراء","l":[7,7],"t":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلۡعَٰلَمِينَ ١٩٢"},{"s":26,"a":193,"n":"الشعراء","l":[7,8],"t":"نَزَلَ بِهِ ٱلرُّوحُ ٱلۡأَمِينُ ١٩٣"},{"s":26,"a":194,"n":"الشعراء","l":[8,8],"t":"عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ ١٩٤"},{"s":26,"a":195,"n":"الشعراء","l":[8,9],"t":"بِلِسَانٍ عَرَبِيّٖ مُّبِينٖ ١٩٥"},{"s":26,"a":196,"n":"الشعراء","l":[9,9],"t":"وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ ١٩٦"},{"s":26,"a":197,"n":"الشعراء","l":[9,10],"t":"أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً أَن يَعۡلَمَهُۥ عُلَمَٰٓؤُاْ بَنِيٓ إِسۡرَٰٓءِيلَ ١٩٧"},{"s":26,"a":198,"n":"الشعراء","l":[10,11],"t":"وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِينَ ١٩٨"},{"s":26,"a":199,"n":"الشعراء","l":[11,11],"t":"فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ ١٩٩"},{"s":26,"a":200,"n":"الشعراء","l":[11,12],"t":"كَذَٰلِكَ سَلَكۡنَٰهُ فِي قُلُوبِ ٱلۡمُجۡرِمِينَ ٢٠٠"},{"s":26,"a":201,"n":"الشعراء","l":[12,13],"t":"لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ ٱلۡأَلِيمَ ٢٠١"},{"s":26,"a":202,"n":"الشعراء","l":[13,13],"t":"فَيَأۡتِيَهُم بَغۡتَةٗ وَهُمۡ لَا يَشۡعُرُونَ ٢٠٢"},{"s":26,"a":203,"n":"الشعراء","l":[13,14],"t":"فَيَقُولُواْ هَلۡ نَحۡنُ مُنظَرُونَ ٢٠٣"},{"s":26,"a":204,"n":"الشعراء","l":[14,14],"t":"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ ٢٠٤"},{"s":26,"a":205,"n":"الشعراء","l":[14,15],"t":"أَفَرَءَيۡتَ إِن مَّتَّعۡنَٰهُمۡ سِنِينَ ٢٠٥"},{"s":26,"a":206,"n":"الشعراء","l":[15,15],"t":"ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ ٢٠٦"}]}
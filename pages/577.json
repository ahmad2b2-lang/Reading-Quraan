{"page":577,"juz":29,"surah":"القِيَامة","surahs":["المُدثر","القِيَامة"],"ayat":[{"s":74,"a":48,"n":"المُدثر","l":[1,1],"t":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ ٤٨"},{"s":74,"a":49,"n":"المُدثر","l":[1,2],"t":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ ٤٩"},{"s":74,"a":50,"n":"المُدثر","l":[2,2],"t":"كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ ٥٠"},{"s":74,"a":51,"n":"المُدثر","l":[2,2],"t":"فَرَّتۡ مِن قَسۡوَرَةِۭ ٥١"},{"s":74,"a":52,"n":"المُدثر","l":[3,3],"t":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ ٥٢"},{"s":74,"a":53,"n":"المُدثر","l":[3,4],"t":"كـَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ ٥٣"},{"s":74,"a":54,"n":"المُدثر","l":[4,4],"t":"كـَلَّآ إِنَّهُۥ تَذۡكِرَةٞ ٥٤"},{"s":74,"a":55,"n":"المُدثر","l":[4,4],"t":"فَمَن شَآءَ ذَكَرَهُۥ ٥٥"},{"s":74,"a":56,"n":"المُدثر","l":[4,5],"t":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ ٥٦"},{"s":75,"a":1,"n":"القِيَامة","l":[8,8],"t":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ١"},{"s":75,"a":2,"n":"القِيَامة","l":[8,8],"t":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ٢"},{"s":75,"a":3,"n":"القِيَامة","l":[8,9],"t":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ٣"},{"s":75,"a":4,"n":"القِيَامة","l":[9,9],"t":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ ٤"},{"s":75,"a":5,"n":"القِيَامة","l":[9,10],"t":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ٥"},{"s":75,"a":6,"n":"القِيَامة","l":[10,10],"t":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ٦"},{"s":75,"a":7,"n":"القِيَامة","l":[10,11],"t":"فَإِذَا بَرِقَ ٱلۡبَصَرُ ٧"},{"s":75,"a":8,"n":"القِيَامة","l":[11,11],"t":"وَخَسَفَ ٱلۡقَمَرُ ٨"},{"s":75,"a":9,"n":"القِيَامة","l":[11,11],"t":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ٩"},{"s":75,"a":10,"n":"القِيَامة","l":[11,12],"t":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ١٠"},{"s":75,"a":11,"n":"القِيَامة","l":[12,12],"t":"كـَلَّا لَا وَزَرَ ١١"},{"s":75,"a":12,"n":"القِيَامة","l":[12,12],"t":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ١٢"},{"s":75,"a":13,"n":"القِيَامة","l":[12,13],"t":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ١٣"},{"s":75,"a":14,"n":"القِيَامة","l":[13,13],"t":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ ١٤"},{"s":75,"a":15,"n":"القِيَامة","l":[14,14],"t":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ١٥"},{"s":75,"a":16,"n":"القِيَامة","l":[14,14],"t":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ ١٦"},{"s":75,"a":17,"n":"القِيَامة","l":[14,15],"t":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ ١٧"},{"s":75,"a":18,"n":"القِيَامة","l":[15,15],"t":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ ١٨"},{"s":75,"a":19,"n":"القِيَامة","l":[15,15],"t":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ١٩"}]}
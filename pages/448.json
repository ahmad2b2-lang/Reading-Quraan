{"page":448,"juz":23,"surah":"الصَّافَات","surahs":["الصَّافَات"],"ayat":[{"s":37,"a":52,"n":"الصَّافَات","l":[1,1],"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ ٥٢"},{"s":37,"a":53,"n":"الصَّافَات","l":[1,2],"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ ٥٣"},{"s":37,"a":54,"n":"الصَّافَات","l":[2,2],"t":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ٥٤"},{"s":37,"a":55,"n":"الصَّافَات","l":[2,3],"t":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ ٥٥"},{"s":37,"a":56,"n":"الصَّافَات","l":[3,3],"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ ٥٦"},{"s":37,"a":57,"n":"الصَّافَات","l":[3,4],"t":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ ٥٧"},{"s":37,"a":58,"n":"الصَّافَات","l":[4,4],"t":"أَفَمَا نَحۡنُ بِمَيِّتِينَ ٥٨"},{"s":37,"a":59,"n":"الصَّافَات","l":[4,5],"t":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ٥٩"},{"s":37,"a":60,"n":"الصَّافَات","l":[5,5],"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٦٠"},{"s":37,"a":61,"n":"الصَّافَات","l":[6,6],"t":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ ٦١"},{"s":37,"a":62,"n":"الصَّافَات","l":[6,7],"t":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ ٦٢"},{"s":37,"a":63,"n":"الصَّافَات","l":[7,7],"t":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ ٦٣"},{"s":37,"a":64,"n":"الصَّافَات","l":[7,8],"t":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ ٦٤"},{"s":37,"a":65,"n":"الصَّافَات","l":[8,8],"t":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ ٦٥"},{"s":37,"a":66,"n":"الصَّافَات","l":[9,9],"t":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٦٦"},{"s":37,"a":67,"n":"الصَّافَات","l":[9,10],"t":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ ٦٧"},{"s":37,"a":68,"n":"الصَّافَات","l":[10,10],"t":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ ٦٨"},{"s":37,"a":69,"n":"الصَّافَات","l":[11,11],"t":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ ٦٩"},{"s":37,"a":70,"n":"الصَّافَات","l":[11,11],"t":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ ٧٠"},{"s":37,"a":71,"n":"الصَّافَات","l":[12,12],"t":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ ٧١"},{"s":37,"a":72,"n":"الصَّافَات","l":[12,13],"t":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ ٧٢"},{"s":37,"a":73,"n":"الصَّافَات","l":[13,13],"t":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ ٧٣"},{"s":37,"a":74,"n":"الصَّافَات","l":[14,14],"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٧٤"},{"s":37,"a":75,"n":"الصَّافَات","l":[14,15],"t":"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ ٧٥"},{"s":37,"a":76,"n":"الصَّافَات","l":[15,15],"t":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ٧٦"}]}
{"page":521,"juz":26,"surah":"الذَّاريَات","surahs":["الذَّاريَات"],"ayat":[{"s":51,"a":7,"n":"الذَّاريَات","l":[1,1],"t":"وَٱلسَّمَآءِ ذَاتِ ٱلۡحُبُكِ ٧"},{"s":51,"a":8,"n":"الذَّاريَات","l":[1,1],"t":"إِنَّكُمۡ لَفِي قَوۡلٖ مُّخۡتَلِفٖ ٨"},{"s":51,"a":9,"n":"الذَّاريَات","l":[1,2],"t":"يُؤۡفَكُ عَنۡهُ مَنۡ أُفِكَ ٩"},{"s":51,"a":10,"n":"الذَّاريَات","l":[2,2],"t":"قُتِلَ ٱلۡخَرَّٰصُونَ ١٠"},{"s":51,"a":11,"n":"الذَّاريَات","l":[2,2],"t":"ٱلَّذِينَ هُمۡ فِي غَمۡرَةٖ سَاهُونَ ١١"},{"s":51,"a":12,"n":"الذَّاريَات","l":[2,3],"t":"يَسۡـَٔلُونَ أَيَّانَ يَوۡمُ ٱلدِّينِ ١٢"},{"s":51,"a":13,"n":"الذَّاريَات","l":[3,3],"t":"يَوۡمَ هُمۡ عَلَى ٱلنَّارِ يُفۡتَنُونَ ١٣"},{"s":51,"a":14,"n":"الذَّاريَات","l":[3,4],"t":"ذُوقُواْ فِتۡنَتَكُمۡ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تَسۡتَعۡجِلُونَ ١٤"},{"s":51,"a":15,"n":"الذَّاريَات","l":[4,4],"t":"إِنَّ ٱلۡمُتَّقِينَ فِي جَنَّٰتٖ وَعُيُونٍ ١٥"},{"s":51,"a":16,"n":"الذَّاريَات","l":[5,5],"t":"ءَاخِذِينَ مَآ ءَاتَىٰهُمۡ رَبُّهُمۡۚ إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُحۡسِنِينَ ١٦"},{"s":51,"a":17,"n":"الذَّاريَات","l":[6,6],"t":"كَانُواْ قَلِيلٗا مِّنَ ٱلَّيۡلِ مَا يَهۡجَعُونَ ١٧"},{"s":51,"a":18,"n":"الذَّاريَات","l":[6,6],"t":"وَبِٱلۡأَسۡحَارِ هُمۡ يَسۡتَغۡفِرُونَ ١٨"},{"s":51,"a":19,"n":"الذَّاريَات","l":[7,7],"t":"وَفِيٓ أَمۡوَٰلِهِمۡ حَقّٞ لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ ١٩"},{"s":51,"a":20,"n":"الذَّاريَات","l":[7,8],"t":"وَفِي ٱلۡأَرۡضِ ءَايَٰتٞ لِّلۡمُوقِنِينَ ٢٠"},{"s":51,"a":21,"n":"الذَّاريَات","l":[8,8],"t":"وَفِيٓ أَنفُسِكُمۡۚ أَفَلَا تُبۡصِرُونَ ٢١"},{"s":51,"a":22,"n":"الذَّاريَات","l":[8,9],"t":"وَفِي ٱلسَّمَآءِ رِزۡقُكُمۡ وَمَا تُوعَدُونَ ٢٢"},{"s":51,"a":23,"n":"الذَّاريَات","l":[9,10],"t":"فَوَرَبِّ ٱلسَّمَآءِ وَٱلۡأَرۡضِ إِنَّهُۥ لَحَقّٞ مِّثۡلَ مَآ أَنَّكُمۡ تَنطِقُونَ ٢٣"},{"s":51,"a":24,"n":"الذَّاريَات","l":[10,10],"t":"هَلۡ أَتَىٰكَ حَدِيثُ ضَيۡفِ إِبۡرَٰهِيمَ ٱلۡمُكۡرَمِينَ ٢٤"},{"s":51,"a":25,"n":"الذَّاريَات","l":[10,11],"t":"إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمٗاۖ قَالَ سَلَٰمٞ قَوۡمٞ مُّنكَرُونَ ٢٥"},{"s":51,"a":26,"n":"الذَّاريَات","l":[11,12],"t":"فَرَاغَ إِلَىٰٓ أَهۡلِهِۦ فَجَآءَ بِعِجۡلٖ سَمِينٖ ٢٦"},{"s":51,"a":27,"n":"الذَّاريَات","l":[12,12],"t":"فَقَرَّبَهُۥٓ إِلَيۡهِمۡ قَالَ أَلَا تَأۡكُلُونَ ٢٧"},{"s":51,"a":28,"n":"الذَّاريَات","l":[13,13],"t":"فَأَوۡجَسَ مِنۡهُمۡ خِيفَةٗۖ قَالُواْ لَا تَخَفۡۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٖ ٢٨"},{"s":51,"a":29,"n":"الذَّاريَات","l":[14,14],"t":"فَأَقۡبَلَتِ ٱمۡرَأَتُهُۥ فِي صَرَّةٖ فَصَكَّتۡ وَجۡهَهَا وَقَالَتۡ عَجُوزٌ عَقِيمٞ ٢٩"},{"s":51,"a":30,"n":"الذَّاريَات","l":[15,15],"t":"قَالُواْ كَذَٰلِكِ قَالَ رَبُّكِۖ إِنَّهُۥ هُوَ ٱلۡحَكِيمُ ٱلۡعَلِيمُ ٣٠"}]}
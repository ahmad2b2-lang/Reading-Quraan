{"page":372,"juz":19,"surah":"الشعراء","surahs":["الشعراء"],"ayat":[{"s":26,"a":112,"n":"الشعراء","l":[1,1],"t":"قَالَ وَمَا عِلۡمِي بِمَا كَانُواْ يَعۡمَلُونَ ١١٢"},{"s":26,"a":113,"n":"الشعراء","l":[1,2],"t":"إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّيۖ لَوۡ تَشۡعُرُونَ ١١٣"},{"s":26,"a":114,"n":"الشعراء","l":[2,2],"t":"وَمَآ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِينَ ١١٤"},{"s":26,"a":115,"n":"الشعراء","l":[2,3],"t":"إِنۡ أَنَا۠ إِلَّا نَذِيرٞ مُّبِينٞ ١١٥"},{"s":26,"a":116,"n":"الشعراء","l":[3,3],"t":"قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِينَ ١١٦"},{"s":26,"a":117,"n":"الشعراء","l":[3,4],"t":"قَالَ رَبِّ إِنَّ قَوۡمِي كَذَّبُونِ ١١٧"},{"s":26,"a":118,"n":"الشعراء","l":[4,5],"t":"فَٱفۡتَحۡ بَيۡنِي وَبَيۡنَهُمۡ فَتۡحٗا وَنَجِّنِي وَمَن مَّعِيَ مِنَ ٱلۡمُؤۡمِنِينَ ١١٨"},{"s":26,"a":119,"n":"الشعراء","l":[5,5],"t":"فَأَنجَيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ ١١٩"},{"s":26,"a":120,"n":"الشعراء","l":[6,6],"t":"ثُمَّ أَغۡرَقۡنَا بَعۡدُ ٱلۡبَاقِينَ ١٢٠"},{"s":26,"a":121,"n":"الشعراء","l":[6,7],"t":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ ١٢١"},{"s":26,"a":122,"n":"الشعراء","l":[7,7],"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ١٢٢"},{"s":26,"a":123,"n":"الشعراء","l":[7,8],"t":"كَذَّبَتۡ عَادٌ ٱلۡمُرۡسَلِينَ ١٢٣"},{"s":26,"a":124,"n":"الشعراء","l":[8,8],"t":"إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ ١٢٤"},{"s":26,"a":125,"n":"الشعراء","l":[8,9],"t":"إِنِّي لَكُمۡ رَسُولٌ أَمِينٞ ١٢٥"},{"s":26,"a":126,"n":"الشعراء","l":[9,9],"t":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ ١٢٦"},{"s":26,"a":127,"n":"الشعراء","l":[9,10],"t":"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ ١٢٧"},{"s":26,"a":128,"n":"الشعراء","l":[10,11],"t":"أَتَبۡنُونَ بِكُلِّ رِيعٍ ءَايَةٗ تَعۡبَثُونَ ١٢٨"},{"s":26,"a":129,"n":"الشعراء","l":[11,11],"t":"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمۡ تَخۡلُدُونَ ١٢٩"},{"s":26,"a":130,"n":"الشعراء","l":[12,12],"t":"وَإِذَا بَطَشۡتُم بَطَشۡتُمۡ جَبَّارِينَ ١٣٠"},{"s":26,"a":131,"n":"الشعراء","l":[12,12],"t":"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ ١٣١"},{"s":26,"a":132,"n":"الشعراء","l":[13,13],"t":"وَٱتَّقُواْ ٱلَّذِيٓ أَمَدَّكُم بِمَا تَعۡلَمُونَ ١٣٢"},{"s":26,"a":133,"n":"الشعراء","l":[13,13],"t":"أَمَدَّكُم بِأَنۡعَٰمٖ وَبَنِينَ ١٣٣"},{"s":26,"a":134,"n":"الشعراء","l":[14,14],"t":"وَجَنَّٰتٖ وَعُيُونٍ ١٣٤"},{"s":26,"a":135,"n":"الشعراء","l":[14,14],"t":"إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمٖ ١٣٥"},{"s":26,"a":136,"n":"الشعراء","l":[15,15],"t":"قَالُواْ سَوَآءٌ عَلَيۡنَآ أَوَعَظۡتَ أَمۡ لَمۡ تَكُن مِّنَ ٱلۡوَٰعِظِينَ ١٣٦"}]}
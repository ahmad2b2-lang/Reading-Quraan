{"page":536,"juz":27,"surah":"الوَاقِعة","surahs":["الوَاقِعة"],"ayat":[{"s":56,"a":51,"n":"الوَاقِعة","l":[1,1],"t":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥١"},{"s":56,"a":52,"n":"الوَاقِعة","l":[1,1],"t":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٢"},{"s":56,"a":53,"n":"الوَاقِعة","l":[2,2],"t":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٣"},{"s":56,"a":54,"n":"الوَاقِعة","l":[2,2],"t":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ٥٤"},{"s":56,"a":55,"n":"الوَاقِعة","l":[2,3],"t":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ٥٥"},{"s":56,"a":56,"n":"الوَاقِعة","l":[3,3],"t":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ٥٦"},{"s":56,"a":57,"n":"الوَاقِعة","l":[3,4],"t":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ٥٧"},{"s":56,"a":58,"n":"الوَاقِعة","l":[4,4],"t":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ ٥٨"},{"s":56,"a":59,"n":"الوَاقِعة","l":[4,5],"t":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٥٩"},{"s":56,"a":60,"n":"الوَاقِعة","l":[5,5],"t":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٠"},{"s":56,"a":61,"n":"الوَاقِعة","l":[6,6],"t":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ٦١"},{"s":56,"a":62,"n":"الوَاقِعة","l":[6,7],"t":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ٦٢"},{"s":56,"a":63,"n":"الوَاقِعة","l":[7,8],"t":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ٦٣"},{"s":56,"a":64,"n":"الوَاقِعة","l":[8,8],"t":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٤"},{"s":56,"a":65,"n":"الوَاقِعة","l":[8,9],"t":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ٦٥"},{"s":56,"a":66,"n":"الوَاقِعة","l":[9,9],"t":"إِنَّا لَمُغۡرَمُونَ ٦٦"},{"s":56,"a":67,"n":"الوَاقِعة","l":[9,10],"t":"بَلۡ نَحۡنُ مَحۡرُومُونَ ٦٧"},{"s":56,"a":68,"n":"الوَاقِعة","l":[10,10],"t":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٦٨"},{"s":56,"a":69,"n":"الوَاقِعة","l":[10,11],"t":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٦٩"},{"s":56,"a":70,"n":"الوَاقِعة","l":[11,12],"t":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٠"},{"s":56,"a":71,"n":"الوَاقِعة","l":[12,12],"t":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧١"},{"s":56,"a":72,"n":"الوَاقِعة","l":[12,13],"t":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٢"},{"s":56,"a":73,"n":"الوَاقِعة","l":[13,14],"t":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٣"},{"s":56,"a":74,"n":"الوَاقِعة","l":[14,14],"t":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٤"},{"s":56,"a":75,"n":"الوَاقِعة","l":[14,15],"t":"۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٥"},{"s":56,"a":76,"n":"الوَاقِعة","l":[15,15],"t":"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٦"}]}
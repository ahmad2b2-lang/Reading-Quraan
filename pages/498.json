{"page":498,"juz":25,"surah":"الدُّخان","surahs":["الدُّخان"],"ayat":[{"s":44,"a":40,"n":"الدُّخان","l":[1,1],"t":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمۡ أَجۡمَعِينَ ٤٠"},{"s":44,"a":41,"n":"الدُّخان","l":[1,2],"t":"يَوۡمَ لَا يُغۡنِي مَوۡلًى عَن مَّوۡلٗى شَيۡـٔٗا وَلَا هُمۡ يُنصَرُونَ ٤١"},{"s":44,"a":42,"n":"الدُّخان","l":[2,3],"t":"إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ ٤٢"},{"s":44,"a":43,"n":"الدُّخان","l":[3,3],"t":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ ٤٣"},{"s":44,"a":44,"n":"الدُّخان","l":[4,4],"t":"طَعَامُ ٱلۡأَثِيمِ ٤٤"},{"s":44,"a":45,"n":"الدُّخان","l":[4,4],"t":"كَٱلۡمُهۡلِ يَغۡلِي فِي ٱلۡبُطُونِ ٤٥"},{"s":44,"a":46,"n":"الدُّخان","l":[5,5],"t":"كَغَلۡيِ ٱلۡحَمِيمِ ٤٦"},{"s":44,"a":47,"n":"الدُّخان","l":[5,6],"t":"خُذُوهُ فَٱعۡتِلُوهُ إِلَىٰ سَوَآءِ ٱلۡجَحِيمِ ٤٧"},{"s":44,"a":48,"n":"الدُّخان","l":[6,7],"t":"ثُمَّ صُبُّواْ فَوۡقَ رَأۡسِهِۦ مِنۡ عَذَابِ ٱلۡحَمِيمِ ٤٨"},{"s":44,"a":49,"n":"الدُّخان","l":[7,7],"t":"ذُقۡ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ ٤٩"},{"s":44,"a":50,"n":"الدُّخان","l":[8,8],"t":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمۡتَرُونَ ٥٠"},{"s":44,"a":51,"n":"الدُّخان","l":[8,9],"t":"إِنَّ ٱلۡمُتَّقِينَ فِي مَقَامٍ أَمِينٖ ٥١"},{"s":44,"a":52,"n":"الدُّخان","l":[9,9],"t":"فِي جَنَّٰتٖ وَعُيُونٖ ٥٢"},{"s":44,"a":53,"n":"الدُّخان","l":[9,10],"t":"يَلۡبَسُونَ مِن سُندُسٖ وَإِسۡتَبۡرَقٖ مُّتَقَٰبِلِينَ ٥٣"},{"s":44,"a":54,"n":"الدُّخان","l":[10,11],"t":"كَذَٰلِكَ وَزَوَّجۡنَٰهُم بِحُورٍ عِينٖ ٥٤"},{"s":44,"a":55,"n":"الدُّخان","l":[11,12],"t":"يَدۡعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ ٥٥"},{"s":44,"a":56,"n":"الدُّخان","l":[12,13],"t":"لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمۡ عَذَابَ ٱلۡجَحِيمِ ٥٦"},{"s":44,"a":57,"n":"الدُّخان","l":[13,14],"t":"فَضۡلٗا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٥٧"},{"s":44,"a":58,"n":"الدُّخان","l":[14,15],"t":"فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ لَعَلَّهُمۡ يَتَذَكَّرُونَ ٥٨"},{"s":44,"a":59,"n":"الدُّخان","l":[15,15],"t":"فَٱرۡتَقِبۡ إِنَّهُم مُّرۡتَقِبُونَ ٥٩"}]}
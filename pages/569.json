{"page":569,"juz":29,"surah":"المَعَارج","surahs":["المَعَارج"],"ayat":[{"s":70,"a":11,"n":"المَعَارج","l":[1,1],"t":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ ١١"},{"s":70,"a":12,"n":"المَعَارج","l":[2,2],"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢"},{"s":70,"a":13,"n":"المَعَارج","l":[2,2],"t":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ ١٣"},{"s":70,"a":14,"n":"المَعَارج","l":[2,3],"t":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ يُنجِيهِ ١٤"},{"s":70,"a":15,"n":"المَعَارج","l":[3,3],"t":"كـَلَّآۖ إِنَّهَا لَظَىٰ ١٥"},{"s":70,"a":16,"n":"المَعَارج","l":[3,3],"t":"نَزَّاعَةٗ لِّلشَّوَىٰ ١٦"},{"s":70,"a":17,"n":"المَعَارج","l":[3,4],"t":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ ١٧"},{"s":70,"a":18,"n":"المَعَارج","l":[4,4],"t":"وَجَمَعَ فَأَوۡعَىٰٓ ١٨"},{"s":70,"a":19,"n":"المَعَارج","l":[4,4],"t":"۞ إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا ١٩"},{"s":70,"a":20,"n":"المَعَارج","l":[4,5],"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعٗا ٢٠"},{"s":70,"a":21,"n":"المَعَارج","l":[5,5],"t":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا ٢١"},{"s":70,"a":22,"n":"المَعَارج","l":[5,5],"t":"إِلَّا ٱلۡمُصَلِّينَ ٢٢"},{"s":70,"a":23,"n":"المَعَارج","l":[5,6],"t":"ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ ٢٣"},{"s":70,"a":24,"n":"المَعَارج","l":[6,6],"t":"وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقّٞ مَّعۡلُومٞ ٢٤"},{"s":70,"a":25,"n":"المَعَارج","l":[6,7],"t":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ ٢٥"},{"s":70,"a":26,"n":"المَعَارج","l":[7,7],"t":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ ٢٦"},{"s":70,"a":27,"n":"المَعَارج","l":[7,8],"t":"وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ ٢٧"},{"s":70,"a":28,"n":"المَعَارج","l":[8,8],"t":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونٖ ٢٨"},{"s":70,"a":29,"n":"المَعَارج","l":[8,9],"t":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ ٢٩"},{"s":70,"a":30,"n":"المَعَارج","l":[9,10],"t":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ ٣٠"},{"s":70,"a":31,"n":"المَعَارج","l":[10,10],"t":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ ٣١"},{"s":70,"a":32,"n":"المَعَارج","l":[10,11],"t":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ ٣٢"},{"s":70,"a":33,"n":"المَعَارج","l":[11,11],"t":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ ٣٣"},{"s":70,"a":34,"n":"المَعَارج","l":[12,12],"t":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ ٣٤"},{"s":70,"a":35,"n":"المَعَارج","l":[12,12],"t":"أُوْلَٰٓئِكَ فِي جَنَّٰتٖ مُّكۡرَمُونَ ٣٥"},{"s":70,"a":36,"n":"المَعَارج","l":[13,13],"t":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ ٣٦"},{"s":70,"a":37,"n":"المَعَارج","l":[13,14],"t":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ٣٧"},{"s":70,"a":38,"n":"المَعَارج","l":[14,14],"t":"أَيَطۡمَعُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمٖ ٣٨"},{"s":70,"a":39,"n":"المَعَارج","l":[14,15],"t":"كـَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ ٣٩"},{"s":70,"a":40,"n":"المَعَارج","l":[15,15],"t":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ٤٠"}]}